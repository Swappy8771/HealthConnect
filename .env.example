# Copy to .env and fill in real values. Never commit .env.

# Port the API listens on (optional, defaults to 5000)
PORT=5000

# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/clinic-booking

# Secret used to sign JWTs (required).
# Use a long random value, e.g. `openssl rand -base64 48`.
# The server refuses to start without it — there is no default.
JWT_SECRET=
